NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Content Studio

# Dev only (ignored in production builds): browse every screen without signing in.
# NEXT_PUBLIC_AUTH_BYPASS=true
# Dev only: serve every API call from the in-memory mock (lib/mock). NEXT_PUBLIC_MOCK_ROLE=admin|member.
# NEXT_PUBLIC_API_MOCK=true
# NEXT_PUBLIC_MOCK_ROLE=admin

# Server-side override for the SSE proxy if the backend is not reachable at the public URL
# API_URL=http://backend:8000/api/v1

# Playwright full-loop walkthrough (optional; specs skip without these)
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=...
# E2E_MEMBER_EMAIL=member@example.com
# E2E_MEMBER_PASSWORD=...
# E2E_BRAND=Ladder
